<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512">
  <defs>
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#0a0a14"/>
      <stop offset="100%" stop-color="#141428"/>
    </linearGradient>
    <linearGradient id="primaryGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#8b5cf6"/>
      <stop offset="100%" stop-color="#0ea5e9"/>
    </linearGradient>
    <linearGradient id="goldGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#f59e0b"/>
      <stop offset="100%" stop-color="#fbbf24"/>
    </linearGradient>
    <filter id="glow" x="-20%" y="-20%" width="140%" height="140%">
      <feGaussianBlur stdDeviation="12" result="blur"/>
      <feComposite in="SourceGraphic" in2="blur" operator="over"/>
    </filter>
  </defs>

  <!-- Background Circle -->
  <rect width="512" height="512" rx="128" fill="url(#bgGrad)"/>
  <rect width="504" height="504" x="4" y="4" rx="124" fill="none" stroke="url(#primaryGrad)" stroke-width="8" opacity="0.6"/>

  <!-- DJ Headphones Arch -->
  <path d="M128 270 C128 170, 190 110, 256 110 C322 110, 384 170, 384 270" 
        fill="none" stroke="url(#primaryGrad)" stroke-width="28" stroke-linecap="round" filter="url(#glow)"/>

  <!-- Earcups -->
  <rect x="96" y="250" width="48" height="96" rx="24" fill="url(#primaryGrad)" filter="url(#glow)"/>
  <rect x="368" y="250" width="48" height="96" rx="24" fill="url(#primaryGrad)" filter="url(#glow)"/>
  <rect x="110" y="266" width="20" height="64" rx="10" fill="#ffffff" opacity="0.8"/>
  <rect x="382" y="266" width="20" height="64" rx="10" fill="#ffffff" opacity="0.8"/>

  <!-- Dove of Holy Spirit in Center -->
  <g transform="translate(256, 270) scale(0.95)">
    <!-- Dove Wings and Body -->
    <path d="M 0, -45 
             C 25, -70 80, -75 110, -50 
             C 80, -35 55, -20 30, -5 
             C 50, 15 50, 45 20, 60 
             C 10, 30 -5, 20 -20, 25 
             C -25, 45 -45, 55 -60, 50 
             C -45, 30 -35, 10 -25, -5 
             C -60, -20 -85, -35 -110, -50 
             C -80, -75 -25, -70 0, -45 Z" 
          fill="#ffffff" filter="url(#glow)"/>
    <!-- Olive Branch / Soundwave -->
    <circle cx="0" cy="-60" r="10" fill="url(#goldGrad)"/>
    <!-- Heart pulse / Cross glow -->
    <path d="M-6, -15 L6, -15 L6, -5 L16, -5 L16, 5 L6, 5 L6, 20 L-6, 20 L-6, 5 L-16, 5 L-16, -5 L-6, -5 Z" fill="url(#primaryGrad)" opacity="0.9"/>
  </g>

  <!-- Crown on Top -->
  <path d="M196 90 L220 120 L256 75 L292 120 L316 90 L310 135 L202 135 Z" fill="url(#goldGrad)" filter="url(#glow)"/>
  <circle cx="196" cy="85" r="7" fill="#ffffff"/>
  <circle cx="256" cy="70" r="8" fill="#ffffff"/>
  <circle cx="316" cy="85" r="7" fill="#ffffff"/>
</svg>
